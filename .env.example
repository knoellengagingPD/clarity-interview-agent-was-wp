# Clarity Interview Agent - backend environment template
#
# Copy to .env for local development. Never commit a filled-in copy: .gitignore
# ignores .env and .env.* and negates only this template.
#
# NOT EXHAUSTIVE. This template documents the authentication and authorization
# variables the server reads. The deployed Vercel project also carries the
# OpenAI, Anthropic, Firebase, Resend, Stripe, Supabase, BigQuery, and Cloud Run
# variables; read them from the project settings rather than from this file.
#
# Every value below is read at runtime with process.env. This is a server-side
# Express service, so no variable here is ever prefixed NEXT_PUBLIC_. A
# NEXT_PUBLIC_ variable is inlined into a browser bundle at build time by the
# Next.js frontends and is therefore published, not secret.

# ─── Admin authentication ─────────────────────────────────────────────────────
# ADMIN_PASSWORD is the single shared operator password for POST /admin/login,
# which exchanges it for a 2 hour HS256 admin token. It is required.
#
# Deployment note, runtime only: set it on the backend Vercel project for the
# production and preview environments. It is read at request time, so no rebuild
# is required. Never expose it as NEXT_PUBLIC_ADMIN_PASSWORD or ship it to any
# browser bundle; a NEXT_PUBLIC_ value is not a credential.
#
#   vercel env add ADMIN_PASSWORD production
#
# Fail-closed behavior: when ADMIN_PASSWORD is unset or empty, POST /admin/login
# logs an error and returns 500. It never issues a token and it never treats an
# empty submission as a match.
ADMIN_PASSWORD=

# AUTH_HMAC_SECRET signs and verifies both the admin token and the district
# portal token. Unset or empty means POST /admin/login, requireAdminJWT, and
# requireDistrictJWT all return 500. Rotating it invalidates every live district
# session immediately.
AUTH_HMAC_SECRET=

# CLARITY_ACCESS_KEY is the participant access key checked by requireAccessKey.
# The Next.js frontends publish the same value as NEXT_PUBLIC_CLARITY_KEY, so
# treat it as a public value that gates anonymous interview writes, not as an
# administrative credential.
CLARITY_ACCESS_KEY=

# CRON_SECRET authorizes the daily Vercel cron invocation of
# POST /fmp/send-checkin-reminder. Unset or empty means that route returns 500
# and FMP reminder email stops.
CRON_SECRET=
